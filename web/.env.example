# The deployed Amicus contract this interface reads.
# Required. The app refuses to render without it rather than showing an empty
# case list, which would be indistinguishable from a network with no disputes.
NEXT_PUBLIC_AMICUS_ADDRESS=0x0000000000000000000000000000000000000000

# Which network to read. One of: localnet, studionet, testnet_asimov,
# testnet_bradbury. Defaults to localnet, matching the default in the project's
# gltest.config.yaml. Shown in the UI at all times.
NEXT_PUBLIC_AMICUS_NETWORK=localnet

# Optional. Overrides the network's default JSON-RPC endpoint - useful when a
# local Studio or GLSim is on a non-standard port.
# NEXT_PUBLIC_AMICUS_RPC_URL=http://127.0.0.1:4000/api
